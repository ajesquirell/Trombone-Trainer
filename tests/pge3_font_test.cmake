# Header generation must preserve PGE3's encoded font, including literal @ signs.
foreach(kind IN ITEMS UPSTREAM GENERATED)
  file(READ "${${kind}_HEADER}" header)
  string(FIND "${header}" "std::string data =" begin)
  string(FIND "${header}" "// Pixels Space, then Pixels Width" end)
  if(begin LESS 0 OR end LESS begin)
    message(FATAL_ERROR "Cannot locate ${kind} PGE3 font payload")
  endif()
  math(EXPR length "${end} - ${begin}")
  string(SUBSTRING "${header}" ${begin} ${length} ${kind}_font)
endforeach()
if(NOT UPSTREAM_font STREQUAL GENERATED_font)
  message(FATAL_ERROR "Generated PGE3 font payload differs from upstream; text glyphs would be corrupted")
endif()
message(STATUS "PGE3 packed font payload preserved exactly")
